---
import StatusBadge from './StatusBadge.astro';

interface Props {
  title: string;
  oneliner: string;
  status: 'built' | 'strategy';
  tags: string[];
  slug: string;
  links: {
    github?: string;
    demo?: string;
    prd?: string;
  };
  index?: number;
}

const { title, oneliner, status, tags, slug, links, index = 0 } = Astro.props;
const projectNum = String(index + 1).padStart(2, '0');
---

<article class="group relative border border-border rounded-xl p-6 bg-surface
  border-l-[3px] border-l-accent
  hover:border-accent/40 hover:shadow-[0_8px_32px_rgba(37,99,235,0.09)]
  hover:-translate-y-1 transition-all duration-200 overflow-hidden">

  <div class="absolute inset-0 bg-gradient-to-br from-accent/[0.025] to-transparent
    opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none rounded-xl" />

  <!-- Top row: badge + project number -->
  <div class="flex items-start justify-between mb-3">
    <StatusBadge {status} />
    <span class="font-mono text-sm font-bold text-ink-muted/35 tabular-nums select-none">{projectNum}</span>
  </div>

  <h3 class="font-bold text-ink text-xl mb-2.5 leading-snug">
    <a href={`/${slug}`} class="hover:text-accent group-hover:text-accent transition-colors">
      {title}
    </a>
  </h3>

  <p class="text-ink-muted text-sm leading-relaxed mb-5">{oneliner}</p>

  <div class="flex flex-wrap gap-1.5 mb-5">
    {tags.map(tag => (
      <span class="font-mono text-xs px-2.5 py-1 bg-canvas text-ink-muted rounded-md border border-border">
        {tag}
      </span>
    ))}
  </div>

  <div class="flex items-center gap-4 text-sm pt-4 border-t border-border">
    <a href={`/${slug}`} class="inline-flex items-center gap-1.5 text-accent font-semibold group/link">
      <span class="underline-offset-2 group-hover/link:underline">Case study</span>
      <span class="transition-transform duration-150 group-hover/link:translate-x-0.5">→</span>
    </a>
    {links.demo && (
      <a href={links.demo} target="_blank" rel="noopener noreferrer"
         class="inline-flex items-center gap-1 text-ink-muted hover:text-ink transition-colors">
        Demo ▶
      </a>
    )}
    {links.github && (
      <a href={links.github} target="_blank" rel="noopener noreferrer"
         class="inline-flex items-center gap-1.5 text-ink-muted hover:text-ink transition-colors ml-auto">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        GitHub ↗
      </a>
    )}
  </div>
</article>
