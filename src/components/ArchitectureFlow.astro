---
interface Props {
  steps: string[];
}
const { steps } = Astro.props;
---

<div class="overflow-x-auto">
  <div class="flex items-center gap-0 min-w-max">
    {steps.map((step, i) => (
      <>
        <div class="flex flex-col items-center">
          <div class="font-mono text-xs text-ink-secondary bg-surface border border-border rounded px-3 py-2 text-center whitespace-nowrap">
            {step}
          </div>
        </div>
        {i < steps.length - 1 && (
          <div class="text-border mx-1 text-ink-muted flex-shrink-0">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M4 10H16M16 10L11 5M16 10L11 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        )}
      </>
    ))}
  </div>
</div>
