---
interface Props {
  label: string;
  value: string;
}
const { label, value } = Astro.props;
---

<div class="border border-border border-t-2 border-t-accent rounded-lg p-4 bg-surface">
  <p class="font-mono text-2xl font-bold text-accent leading-none">{value}</p>
  <p class="text-xs text-ink-muted mt-2 leading-snug">{label}</p>
</div>
