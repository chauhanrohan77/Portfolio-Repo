---
import StatusBadge from './StatusBadge.astro';

interface Props {
  title: string;
  oneliner: string;
  status: 'built' | 'strategy';
  slug: string;
}

const { title, oneliner, status, slug } = Astro.props;
---

<article class="group border border-border rounded-xl p-5 bg-surface
  hover:border-accent/40 hover:shadow-[0_2px_16px_rgba(37,99,235,0.06)]
  hover:-translate-y-0.5 transition-all duration-200 flex items-start justify-between gap-4">

  <div class="flex-1 min-w-0">
    <div class="mb-2">
      <StatusBadge {status} />
    </div>
    <h3 class="font-semibold text-ink mb-1.5 group-hover:text-accent transition-colors">
      <a href={`/${slug}`}>{title}</a>
    </h3>
    <p class="text-sm text-ink-muted leading-relaxed">{oneliner}</p>
  </div>

  <a href={`/${slug}`}
     class="flex-shrink-0 inline-flex items-center gap-1 text-sm text-accent mt-1 group/link">
    <span class="underline-offset-2 group-hover/link:underline whitespace-nowrap">Read</span>
    <span class="transition-transform duration-150 group-hover/link:translate-x-0.5">→</span>
  </a>
</article>
