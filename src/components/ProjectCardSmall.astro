---
import StatusBadge from './StatusBadge.astro';

interface Props {
  title: string;
  oneliner: string;
  status: 'built' | 'strategy';
  slug: string;
}

const { title, oneliner, status, slug } = Astro.props;
---

<article class="border border-border rounded-lg p-5 bg-surface hover:border-accent/50 transition-colors duration-150 flex items-start justify-between gap-4">
  <div class="flex-1 min-w-0">
    <div class="mb-2">
      <StatusBadge {status} />
    </div>
    <h3 class="font-semibold text-ink mb-1.5">
      <a href={`/${slug}`} class="hover:text-accent transition-colors">
        {title}
      </a>
    </h3>
    <p class="text-sm text-ink-muted leading-relaxed">{oneliner}</p>
  </div>
  <a href={`/${slug}`} class="flex-shrink-0 text-sm text-accent hover:underline whitespace-nowrap mt-1">
    Read →
  </a>
</article>
