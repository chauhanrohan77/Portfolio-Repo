---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Rohan Chauhan">
  <div class="max-w-3xl mx-auto px-6 py-32 text-center">
    <p class="font-mono text-sm text-ink-muted mb-4">404</p>
    <h1 class="text-3xl font-bold text-ink mb-4">Page not found</h1>
    <p class="text-ink-muted mb-8">
      This page doesn't exist or has been moved.
    </p>
    <a href="/" class="text-accent hover:underline text-sm">
      ← Back to home
    </a>
  </div>
</BaseLayout>
