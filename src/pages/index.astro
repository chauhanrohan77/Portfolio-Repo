---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectCardSmall from '../components/ProjectCardSmall.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const sorted = allProjects.sort((a, b) => a.data.order - b.data.order);
const builtProjects = sorted.filter(p => p.data.status === 'built');
const strategyProjects = sorted.filter(p => p.data.status === 'strategy');
---

<BaseLayout title="Rohan Chauhan — AI Product Manager">
  <div class="max-w-3xl mx-auto px-6">

    <!-- Hero -->
    <section class="pt-20 pb-16 border-b border-border fade-in">
      <p class="font-mono text-sm text-ink-muted mb-6">Rohan Chauhan · Dubai, UAE</p>
      <h1 class="text-4xl sm:text-5xl font-bold text-ink leading-tight tracking-tight mb-6">
        AI Product Manager<br />for regulated industries.
      </h1>
      <p class="text-lg text-ink-secondary leading-relaxed max-w-xl mb-4">
        Five years of engineering and product at Microsoft (Azure Storage) and OYO —
        $400M+ in revenue impact across cloud infrastructure and AI-led transformations.
        Now translating that technical depth into agentic AI systems that compliance
        functions can actually defend.
      </p>
      <p class="text-sm text-ink-muted leading-relaxed max-w-xl mb-10">
        Three working agent builds grounded in the EU AI Act, CBUAE, DIFC, and SDAIA
        frameworks — plus product strategy work in Dubai real estate and GCC consumer
        marketplaces.
      </p>

      <div class="flex flex-wrap gap-x-8 gap-y-4">
        <div>
          <p class="font-mono text-xl font-semibold text-ink">$400M+</p>
          <p class="text-xs text-ink-muted mt-0.5">Revenue impact</p>
        </div>
        <div class="w-px bg-border self-stretch hidden sm:block" />
        <div>
          <p class="font-mono text-xl font-semibold text-ink">5 yrs</p>
          <p class="text-xs text-ink-muted mt-0.5">Microsoft & OYO</p>
        </div>
        <div class="w-px bg-border self-stretch hidden sm:block" />
        <div>
          <p class="font-mono text-xl font-semibold text-ink">3</p>
          <p class="text-xs text-ink-muted mt-0.5">Agent builds shipped</p>
        </div>
        <div class="w-px bg-border self-stretch hidden sm:block" />
        <div>
          <p class="font-mono text-xl font-semibold text-ink">3</p>
          <p class="text-xs text-ink-muted mt-0.5">Jurisdictions covered</p>
        </div>
      </div>
    </section>

    <!-- Built projects -->
    <section id="projects" class="py-16 border-b border-border">
      <h2 class="font-mono text-xs uppercase tracking-wider text-ink-muted mb-8">
        Built projects
      </h2>
      <div class="flex flex-col gap-4">
        {builtProjects.map(project => (
          <ProjectCard
            title={project.data.title}
            oneliner={project.data.oneliner}
            status={project.data.status}
            tags={project.data.tags}
            slug={project.id}
            links={project.data.links}
          />
        ))}
      </div>
    </section>

    <!-- Strategy work -->
    <section class="py-16 border-b border-border">
      <h2 class="font-mono text-xs uppercase tracking-wider text-ink-muted mb-8">
        Strategy work
      </h2>
      <div class="flex flex-col gap-3">
        {strategyProjects.map(project => (
          <ProjectCardSmall
            title={project.data.title}
            oneliner={project.data.oneliner}
            status={project.data.status}
            slug={project.id}
          />
        ))}
      </div>
    </section>

    <!-- About -->
    <section id="about" class="py-16 border-b border-border">
      <h2 class="font-mono text-xs uppercase tracking-wider text-ink-muted mb-6">
        About
      </h2>
      <div class="max-w-xl space-y-4 text-ink-secondary leading-relaxed">
        <p>
          I'm a product manager with five years of engineering experience at Microsoft
          (Azure Storage) and OYO, and currently completing an MBA at IIM Ahmedabad's
          Dubai campus.
        </p>
        <p>
          At Microsoft I shipped features across Azure Storage — Cold tier launch, batch-processing
          APIs at scale, the anonymous read implementation that anchored a $150M Databricks contract,
          and an internal GenAI developer assistant. That experience in high-stakes infrastructure
          shaped how I think about AI in regulated industries: deterministic rules for what must be
          auditable, LLMs for what benefits from language, humans on every consequential decision.
        </p>
        <p>
          Based in Dubai. Open to product and consulting roles in the GCC and Europe.
          Reach out by email or LinkedIn.
        </p>
      </div>
    </section>

    <!-- Contact -->
    <section class="py-16">
      <h2 class="font-mono text-xs uppercase tracking-wider text-ink-muted mb-6">
        Contact
      </h2>
      <div class="flex flex-wrap items-center gap-6 text-sm">
        <a
          href="mailto:dx25rohanc@iima.ac.in"
          class="text-accent hover:underline"
        >
          dx25rohanc@iima.ac.in
        </a>
        <a
          href="https://linkedin.com/in/rohan-chauhan-011c"
          target="_blank"
          rel="noopener noreferrer"
          class="text-ink-muted hover:text-ink transition-colors"
        >
          LinkedIn ↗
        </a>
        <a
          href="/cv-rohan-chauhan.pdf"
          class="text-ink-muted hover:text-ink transition-colors"
        >
          Download CV ↓
        </a>
      </div>
    </section>

  </div>
</BaseLayout>
